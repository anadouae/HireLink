# HireLink - variables d'environnement (modele). Copiez en ".env" (ignore par Git).
# Spring Boot ne lit pas ".env" tout seul : definissez ces variables dans IntelliJ
# (Run > Edit Configurations > Environment variables), via "setx" sous Windows,
# ou chargez-les dans votre shell avant "mvn spring-boot:run".
# Toutes sont OPTIONNELLES en developpement ; HIRELINK_JWT_SECRET est OBLIGATOIRE avec le profil "prod".

HIRELINK_JWT_SECRET=
HIRELINK_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
HIRELINK_FRONTEND_URL=http://localhost:5500
HIRELINK_GOOGLE_CLIENT_ID=
HIRELINK_LLM_API_KEY=
HIRELINK_GEMINI_API_KEY=
HIRELINK_GROQ_API_KEY=
HIRELINK_MISTRAL_API_KEY=
HIRELINK_WEBAUTHN_RP_ID=localhost
HIRELINK_WEBAUTHN_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
HIRELINK_SWAGGER_ENABLED=false
# Premier administrateur (profil prod uniquement, cree s'il n'existe aucun admin)
HIRELINK_ADMIN_EMAIL=
HIRELINK_ADMIN_PASSWORD=

# --- E-mails (SMTP, STARTTLS) : tous profils. Vide = e-mails journalises et visibles dans Administration > E-mails envoyes ---
HIRELINK_MAIL_HOST=
HIRELINK_MAIL_PORT=587
HIRELINK_MAIL_USERNAME=
HIRELINK_MAIL_PASSWORD=
HIRELINK_MAIL_FROM=

# --- Profil "prod" uniquement (--spring.profiles.active=prod) ---
HIRELINK_DB_URL=jdbc:mysql://localhost:3306/hirelink?useSSL=true&serverTimezone=UTC
HIRELINK_DB_USER=
HIRELINK_DB_PASSWORD=
