@startuml
left to right direction
skinparam packageStyle rectangle
actor "Candidat" as C
actor "Personne RH\n(Owner / Recruteur)" as RH
actor "Hiring Manager" as HM
actor "Administrateur de l'application HireLink" as A
rectangle "« système »\nMatching local" as M
rectangle "« système »\nFournisseur LLM" as L
rectangle "« système »\nMessagerie / e-mail" as E
rectangle "« système »\nPaiement / facturation" as P
rectangle "« système »\nScheduler SLA" as S
rectangle "« système »\nIdentité Google" as G
rectangle "HireLink" {
  usecase "S'authentifier" as Auth
  usecase "Postuler à une offre" as Post
  usecase "Calculer le matching local" as Match
  usecase "Créer / publier une offre" as Creer
  usecase "Définir le SLA de l'offre" as SLA
  usecase "Utiliser l'assistance IA" as IA
  usecase "Débiter un crédit IA" as Credit
  usecase "Notifier (in-app / e-mail)" as Notif
  usecase "Motiver un refus" as Refus
  usecase "Avancer une candidature" as Avancer
  usecase "Auth. via Google" as AG
  usecase "Gérer paiement / abonnement" as Pay
}
C --> Auth
C --> Post
RH --> Creer
RH --> Avancer
HM --> Auth
A --> Auth
Post ..> Match : <<include>>
Creer ..> SLA : <<include>>
IA ..> Credit : <<include>>
Post ..> Notif : <<include>>
Refus ..> Avancer : <<extend>>
AG ..> Auth : <<extend>>
Pay ..> IA : <<extend>>
M --> Match
L --> IA
E --> Notif
P --> Pay
S --> Auth
G --> AG
@enduml
