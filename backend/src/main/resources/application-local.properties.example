# =============================================================================
# HireLink - secrets locaux (NE JAMAIS COMMITTER)
# Copiez ce fichier en "application-local.properties" a cote de pom.xml (dossier backend/)
# ou dans backend/src/main/resources/. Il est ignore par Git et charge automatiquement.
# TOUT EST OPTIONNEL : sans aucune cle, l'application demarre et fonctionne
# (le scoring IA retombe sur l'analyse locale, la cle JWT est generee automatiquement
# dans backend/data/jwt.key).
# =============================================================================

# --- Jeton de session (JWT) : 64 caracteres aleatoires minimum -----------------
# Generer :  python -c "import secrets;print(secrets.token_urlsafe(64))"
# hirelink.jwt.secret=COLLER_ICI_UNE_VALEUR_ALEATOIRE_LONGUE

# --- Assistant IA (facultatif) -------------------------------------------------
hirelink.llm.provider=gemini
hirelink.llm.fallback-chain=gemini,groq,mistral
hirelink.llm.gemini.api-key=COLLER_CLE_GEMINI_ICI
hirelink.llm.groq.api-key=COLLER_CLE_GROQ_ICI
hirelink.llm.mistral.api-key=COLLER_CLE_MISTRAL_ICI

# --- Connexion Google (facultatif) ---------------------------------------------
# hirelink.google.client-id=XXXX.apps.googleusercontent.com

# --- E-mails (SMTP) ------------------------------------------------------------
# Exemple Gmail : activez la validation en 2 etapes puis creez un "mot de passe d'application"
# (compte Google > Securite > Mots de passe des applications). Ne jamais utiliser le mot de passe habituel du compte.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=votre.adresse@gmail.com
spring.mail.password=COLLER_ICI_LE_MOT_DE_PASSE_D_APPLICATION_A_16_CARACTERES
hirelink.mail.from=HireLink <votre.adresse@gmail.com>
# Autre serveur SMTP : changer host / port / username / password. Serveur sans chiffrement (outil de test local) :
# spring.mail.properties.mail.smtp.starttls.enable=false
# spring.mail.properties.mail.smtp.starttls.required=false
# spring.mail.properties.mail.smtp.auth=false
