# =============================================================================
# HireLink — modèle UNIQUE de configuration locale (SANS SECRETS)
#
# Copier vers :  backend/application-local.properties
#                (à côté de pom.xml — fichier ignoré par Git)
#
# Ordre de chargement Spring Boot (du plus faible au plus fort) :
#   1) application.properties (JAR / resources)
#   2) application-{profile}.properties (ex. prod)
#   3) spring.config.import → optional:file:./application-local.properties
#   4) variables d'environnement / -D... (priorité la plus haute)
#
# Ce fichier d'exemple ne contient AUCUNE clé réelle, AUCUN mot de passe.
# =============================================================================

# --- Base de données (compte MySQL dédié — NE PAS utiliser root en recette/prod) ---
# Créer par ex. :
#   CREATE USER 'hirelink_app'@'localhost' IDENTIFIED BY '***choisir***';
#   CREATE DATABASE hirelink_demo CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   GRANT SELECT,INSERT,UPDATE,DELETE,CREATE,INDEX,ALTER,REFERENCES,CREATE TEMPORARY TABLES
#     ON hirelink_demo.* TO 'hirelink_app'@'localhost';
#   FLUSH PRIVILEGES;
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/hirelink_demo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
spring.datasource.username=hirelink_app
spring.datasource.password=

# --- Ports / URLs frontend -----------------------------------------------
# server.port=8081
# hirelink.frontend.base-url=http://127.0.0.1:5500
# hirelink.cors.allowed-origins=http://127.0.0.1:5500,http://localhost:5500

# --- JWT -----------------------------------------------------------------
# Laisser vide : un secret 512 bits est généré au 1er démarrage dans
# backend/data/jwt.key (permissions owner-only sous POSIX ; Windows = ACL user).
# Ne jamais committer jwt.key. Optionnel : HIRELINK_JWT_SECRET (≥ 32 caractères).
# hirelink.jwt.secret=
# hirelink.jwt.key-file=data/jwt.key
# hirelink.jwt.access-ttl-minutes=15

# --- Seed démonstration --------------------------------------------------
# Le seed reste désactivé par défaut ; l'activer uniquement sur une base de test dédiée.
hirelink.seed.enabled=false
# NE JAMAIS laisser à true en permanence : purge + rechargement destructif
hirelink.seed.force-reset=false

# --- MFA administrateur --------------------------------------------------
# Démonstration locale explicitement choisie : false (mot de passe seul tant
# que MFA non activée manuellement — voir docs/ADMIN_MFA_DEMO.md).
# Hors démo locale (recette / préprod / prod) : true
hirelink.security.admin-mfa-required=false

# --- SMTP (FACULTATIF — laisser vide = journalisation, pas d'envoi réel) ---
# spring.mail.host=
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
# hirelink.mail.from=

# --- Assistant IA (FACULTATIF — sans clé = repli local explicite) ---------
# Ne pas coller de fausse clé : une clé factice provoquerait des erreurs API.
# hirelink.llm.provider=
# hirelink.llm.gemini.api-key=
# hirelink.llm.groq.api-key=
# hirelink.llm.mistral.api-key=

# --- Services externes : rester DÉSACTIVÉS par défaut en install propre ---
hirelink.external-jobs.startup-sync=false
hirelink.external-jobs.maroc.enabled=false
hirelink.external-jobs.remoteok.enabled=false
hirelink.external-jobs.greenhouse.enabled=false
hirelink.external-jobs.lever.enabled=false
hirelink.external-jobs.ashby.enabled=false
hirelink.external-jobs.jooble.enabled=false
hirelink.web-search.enabled=false

# --- OTP console (démo locale sans SMTP uniquement) ----------------------
# hirelink.otp.log-to-console=false

# --- Google / WebAuthn (FACULTATIF) --------------------------------------
# hirelink.google.client-id=
# hirelink.webauthn.rp-id=localhost
